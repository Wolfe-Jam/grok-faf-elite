<script lang="ts">
	/**
	 * ScoreRepo - ONE-CLICK FAF
	 *
	 * PATH A: Existing project.faf → Score it
	 * PATH B: No project.faf → Generate + Commit
	 */

	import { onMount } from 'svelte';
	import { isWasmReady, generateAndScore } from '$lib/wasm-loader';

	// Props
	interface Props {
		initialUrl?: string;
		onClose?: () => void;
	}
	let { initialUrl = 'https://github.com/Wolfe-Jam/test-faf-demo', onClose }: Props = $props();

	// Reactive state that updates when prop changes
	let repoUrl = $derived(initialUrl);

	// State
	let loading = $state(false);
	let generating = $state(false);
	let error = $state('');
	let repoOwner = $state('');
	let repoName = $state('');

	// Score state
	let score = $state<number | null>(null);
	let hasExistingFaf = $state(false);

	// Generation result (PATH B)
	let generationResult = $state<{
		score: number;
		genTime: number;
		scoreTime: number;
		missingFields: string[];
		commitUrl?: string;
	} | null>(null);

	// Share state
	let shared = $state(false);

	// Tier system
	function getTier(s: number): { emoji: string; name: string; color: string; note?: string } {
		if (s >= 105) return { emoji: '🍊', name: 'Big Orange', color: 'text-orange-500', note: 'The Michelin Star for Repos' };
		if (s >= 100) return { emoji: '🏆', name: 'Trophy', color: 'text-yellow-400', note: 'Gold Code - Perfect Score!' };
		if (s >= 99) return { emoji: '🥇', name: 'Gold', color: 'text-yellow-300' };
		if (s >= 95) return { emoji: '🥈', name: 'Silver', color: 'text-gray-300' };
		if (s >= 85) return { emoji: '🥉', name: 'Bronze', color: 'text-amber-600' };
		if (s >= 70) return { emoji: '🟢', name: 'Green', color: 'text-green-500' };
		if (s >= 55) return { emoji: '🟡', name: 'Yellow', color: 'text-yellow-500' };
		return { emoji: '🔴', name: 'Needs Work', color: 'text-red-500' };
	}

	const displayScore = $derived(generationResult ? generationResult.score : score ?? 0);
	const tier = $derived(displayScore > 0 ? getTier(displayScore) : null);

	// Auto-check on mount only (component recreates via {#key} wrapper)
	onMount(() => {
		checkScore();
	});

	/**
	 * Check for existing project.faf or trigger generation
	 */
	async function checkScore() {
		if (!repoUrl.trim()) return;

		loading = true;
		error = '';
		score = null;
		hasExistingFaf = false;
		generationResult = null;
		shared = false;

		try {
			// Parse GitHub URL
			const url = new URL(repoUrl);
			const pathParts = url.pathname.split('/').filter(Boolean);
			if (pathParts.length < 2) {
				throw new Error('Invalid GitHub URL');
			}

			const owner = pathParts[0];
			const repo = pathParts[1];
			repoOwner = owner;
			repoName = repo;

			// Try to fetch existing project.faf (disable cache)
			const rawUrl = `https://raw.githubusercontent.com/${owner}/${repo}/main/project.faf`;
			const response = await fetch(rawUrl, { cache: 'no-store' });

			if (!response.ok) {
				// Try master branch
				const masterUrl = `https://raw.githubusercontent.com/${owner}/${repo}/master/project.faf`;
				const masterResponse = await fetch(masterUrl, { cache: 'no-store' });
				if (!masterResponse.ok) {
					// PATH B: No project.faf found → Auto-generate
					loading = false;
					await initializeProjectFaf();
					return;
				}
				const fafContent = await masterResponse.text();
				scoreExistingFaf(fafContent);
			} else {
				const fafContent = await response.text();
				scoreExistingFaf(fafContent);
			}
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to fetch repo';
		} finally {
			loading = false;
		}
	}

	/**
	 * PATH A: Score existing project.faf file
	 */
	function scoreExistingFaf(fafContent: string) {
		// Simple scoring based on filled fields
		const hasProject = /^project:/m.test(fafContent);
		const hasGoal = /goal:/m.test(fafContent);
		const hasStack = /^stack:/m.test(fafContent);
		const hasHumanContext = /^human_context:/m.test(fafContent);
		const hasWho = /who:/m.test(fafContent);
		const hasWhat = /what:/m.test(fafContent);
		const hasWhy = /why:/m.test(fafContent);
		const hasWhere = /where:/m.test(fafContent);
		const hasWhen = /when:/m.test(fafContent);
		const hasHow = /how:/m.test(fafContent);
		const hasMainLang = /main_language:/m.test(fafContent);
		const hasType = /type:/m.test(fafContent);

		const filledSlots = [
			hasProject, hasGoal, hasStack, hasHumanContext,
			hasWho, hasWhat, hasWhy, hasWhere, hasWhen, hasHow,
			hasMainLang, hasType
		].filter(Boolean).length;

		score = Math.min(100, Math.round((filledSlots / 12) * 100));
		hasExistingFaf = true;
	}

	/**
	 * PATH B: Generate + Commit with WASM
	 */
	async function initializeProjectFaf() {
		if (!repoOwner || !repoName) {
			error = 'Invalid repository';
			return;
		}

		// Check if WASM is ready
		if (!isWasmReady()) {
			error = 'WASM not loaded yet - please wait';
			return;
		}

		generating = true;
		error = '';

		try {
			// Fetch repo metadata
			const repoResponse = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}`, { cache: 'no-store' });
			if (!repoResponse.ok) {
				throw new Error(repoResponse.status === 404 ? 'Repository not found' : `GitHub API error: ${repoResponse.status}`);
			}

			const repoData = await repoResponse.json();
			const description = repoData.description || null;
			const language = repoData.language || null;

			// Fetch README
			const readmeResponse = await fetch(
				`https://api.github.com/repos/${repoOwner}/${repoName}/readme`,
				{
					headers: { 'Accept': 'application/vnd.github.v3.raw' },
					cache: 'no-store'
				}
			);
			const readme = readmeResponse.ok ? await readmeResponse.text() : null;

			// Fetch package.json
			const packageResponse = await fetch(
				`https://raw.githubusercontent.com/${repoOwner}/${repoName}/main/package.json`,
				{ cache: 'no-store' }
			);
			const packageJson = packageResponse.ok ? await packageResponse.text() : null;

			// Generate with WASM
			const result = await generateAndScore(repoOwner, repoName, description, readme, packageJson, language);

			// Store result and display (no commit for testing)
			generationResult = {
				score: result.score,
				genTime: result.genTime,
				scoreTime: result.scoreTime,
				missingFields: result.missingFields
			};
		} catch (err) {
			error = err instanceof Error ? err.message : 'Generation failed';
			generating = false;
		}
	}

	/**
	 * Share to X
	 */
	function shareToX() {
		if (displayScore === null || !tier) return;

		const text = encodeURIComponent(
			`${repoName} scored ${displayScore}% on FAF AI-readiness! ${tier.emoji}

${displayScore >= 100 ? 'Gold Code achieved!' : 'On the path to Gold Code!'}

Check your score: https://grok-faf-elite.vercel.app

#FAF #GoldCode #AIReadiness`
		);

		window.open(`https://x.com/intent/tweet?text=${text}`, '_blank');
		shared = true;
	}

	/**
	 * Reset and close modal to try another repo
	 */
	function reset() {
		score = null;
		hasExistingFaf = false;
		generationResult = null;
		error = '';
		repoOwner = '';
		repoName = '';
		shared = false;
		onClose?.();
	}
</script>

<div class="space-y-4">
	{#if loading || generating}
		<!-- Loading/Generating State - Minimal (it's fast!) -->
		<div class="text-center py-8">
			{#if loading}
				<p class="text-lg font-semibold text-foreground">Loading repo...</p>
			{:else if generating}
				<p class="text-lg font-semibold text-foreground">faf init for dummies</p>
				<p class="text-sm text-muted-foreground mt-2">Making your repo AI-ready...</p>
			{/if}
		</div>
	{:else if error}
		<!-- Error State -->
		<div class="p-4 rounded-lg bg-red-500/10 border border-red-500/30">
			<p class="text-sm font-semibold text-red-400">{error}</p>
		</div>
	{:else if hasExistingFaf || generationResult}
		<!-- Score Display State -->
		<div class="text-center py-6">
			<div class="text-6xl mb-4">{tier?.emoji}</div>
			<div class="text-5xl font-bold {tier?.color} mb-2">{displayScore}%</div>
			<div class="text-lg text-muted-foreground">{tier?.name}</div>
			{#if tier?.note}
				<div class="text-xs text-primary mt-1">{tier.note}</div>
			{/if}
			<div class="text-sm text-foreground mt-2">{repoName}</div>
		</div>

		<!-- Existing project.faf indicator (PATH A) -->
		{#if hasExistingFaf && !generationResult}
			<div class="p-4 rounded-lg bg-black border border-white/20">
				<p class="text-sm font-bold text-white mb-2 text-center">✅ Existing project.faf</p>
				<a
					href="https://github.com/{repoOwner}/{repoName}/blob/main/project.faf"
					target="_blank"
					rel="noopener noreferrer"
					class="block text-center text-sm text-primary hover:underline font-semibold"
				>
					View project.faf on GitHub →
				</a>
			</div>
		{/if}

		<!-- Performance Stats (PATH B) -->
		{#if generationResult}
			<div class="p-4 rounded-lg bg-primary/10 border border-primary/30">
				<p class="text-sm font-bold text-primary mb-2">⚡ DOUBLE-WHAMMY Performance:</p>
				<div class="text-xs text-foreground space-y-1">
					<div>🦀 Generated in {generationResult.genTime.toFixed(2)}ms by Rust WASM (312KB)</div>
					<div>⚡ Scored in {generationResult.scoreTime.toFixed(2)}μs by Zig WASM (2.7KB)</div>
					<div class="text-muted-foreground mt-2">71,428 scores/second • 314.7KB total</div>
				</div>
				{#if generationResult.commitUrl}
					<a
						href={generationResult.commitUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-3 block text-sm text-primary hover:underline"
					>
						View project.faf on GitHub →
					</a>
				{/if}
			</div>

			<!-- Missing Fields -->
			{#if generationResult.missingFields.length > 0}
				<div class="p-4 rounded-lg bg-muted-foreground/10 border border-muted-foreground/20">
					<p class="text-sm font-bold text-foreground mb-2">
						Missing Context ({generationResult.missingFields.length} fields):
					</p>
					<ul class="text-xs text-muted-foreground space-y-1">
						{#each generationResult.missingFields as field}
							<li>• {field.toUpperCase()}: Add to README for better AI context</li>
						{/each}
					</ul>
				</div>
			{/if}
		{/if}

		<!-- Progress bar -->
		<div class="w-full bg-muted-foreground/20 rounded-full h-3 overflow-hidden">
			<div
				class="h-full rounded-full transition-all duration-500 {displayScore >= 100 ? 'bg-green-500' : displayScore >= 70 ? 'bg-green-500' : 'bg-red-500'}"
				style="width: {Math.min(displayScore, 100)}%"
			></div>
		</div>

		<!-- Actions -->
		<div class="flex gap-3 pt-4">
			<button
				onclick={shareToX}
				class="flex-1 py-2 px-4 bg-black text-white font-semibold rounded-lg border border-white/20
					hover:bg-black/80 transition-colors duration-200
					focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-muted
					flex items-center justify-center gap-2"
			>
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
				</svg>
				{shared ? 'Shared!' : 'Share Score'}
			</button>
			<button
				onclick={reset}
				class="py-2 px-4 bg-black text-white font-semibold rounded-lg border border-white/20
					hover:bg-black/80 transition-colors duration-200
					focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-muted"
			>
				Try Another
			</button>
		</div>
	{/if}
</div>
