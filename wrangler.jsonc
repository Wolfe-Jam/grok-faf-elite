{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-faf-elite",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set via `wrangler secret put` — never commit values):
  //   UPSTASH_REDIS_REST_URL    — stats counter endpoint
  //   UPSTASH_REDIS_REST_TOKEN  — stats counter auth
  //   GITHUB_CLIENT_ID          — OAuth app id (commit-faf + add-faf code exchange)
  //   GITHUB_CLIENT_SECRET      — OAuth app secret (commit-faf + add-faf code exchange)
  //
  // X (Twitter) sharing uses web intent (no auth, no tokens) — see src/lib/share.ts.
}
